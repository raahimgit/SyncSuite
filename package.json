{
  "name": "syncsuite",
  "version": "0.1.0",
  "description": "Self-hostable incremental data synchronization engine with checkpoints, retries, rate limits and dead letters.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "syncsuite": "./dist/cli/index.js",
    "synckit": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest run test/unit/benchmarks.test.ts",
    "syncsuite:validate": "syncsuite validate syncsuite.yaml",
    "syncsuite:apply": "syncsuite jobs apply syncsuite.yaml",
    "syncsuite:dry-run": "syncsuite sync syncsuite.yaml --dry-run",
    "syncsuite:sync": "syncsuite sync syncsuite.yaml",
    "syncsuite:status": "syncsuite status"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "pg": "^8.13.0",
    "yaml": "^2.9.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0"
  }
}
